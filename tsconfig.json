{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",

    "lib": ["ES2023", "DOM"],

    "moduleResolution": "bundler",

    "types": ["vite/client"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "erasableSyntaxOnly": true
  },

  "include": ["src"]
}
